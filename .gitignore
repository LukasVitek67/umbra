# Build output
/target/
/dist/
app/build/
app/.dart_tool/
app/windows/flutter/ephemeral/
app/rust_builder/cargokit/build_tool/.dart_tool/
app/.flutter-plugins-dependencies

# Release signing key — the app installs only what this key signed.
# It must never be committed, anywhere, ever.
*release-key*
*.key
*.pem

# The GIPHY API key compiled into releases. Not a credential for anything but
# GIF search, but a public repo gets scraped and the key then gets disabled for
# everyone, so it lives outside the tree and reaches the build as an env var.
*giphy-key*

# Tor binaries shipped with releases (fetched from the Tor Project, not ours)
dist/tor/

# Local editor / OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
